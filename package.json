  "version": "0.0.0",
  "description": "Cross-framework lightweight component library",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
