{
  "name": "@y-ui/svelte",
  "version": "0.1.0",
  "description": "Svelte implementation of Y-UI components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "svelte": "./dist/*.js",
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "svelte": ">=4.0.0"
  },
  "dependencies": {
    "@y-ui/core": "workspace:*"
  },
  "devDependencies": {
    "svelte": "^4.2.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "svelte-check": "^3.8.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
